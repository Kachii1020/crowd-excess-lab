# OpenDART: https://opendart.fss.or.kr/
OPENDART_API_KEY=replace_with_your_key

# NAVER API HUB Search Trend (not the legacy Developers endpoint).
NAVER_API_HUB_CLIENT_ID=replace_with_your_client_id
NAVER_API_HUB_CLIENT_SECRET=replace_with_your_client_secret

# Public Data Portal: FSC stock-price and market-index services.
DATA_GO_KR_API_KEY=replace_with_your_public_data_portal_key

# Local, manually downloaded KRX files. Files stay outside Git by default.
KRX_PRICE_CSV=data/raw/krx_prices.csv
KRX_INVESTOR_FLOW_CSV=data/raw/krx_investor_flows.csv

# Community observations obtained by an allowed method.
COMMUNITY_OBSERVATIONS_CSV=data/raw/community_observations.csv

# Generated, Git-ignored mini event-study runs.
STUDY_OUTPUT_ROOT=data/processed/mini_event_study

# OpenAI Responses API. Never expose this value to the browser.
OPENAI_API_KEY=replace_with_your_openai_key
OPENAI_MODEL=gpt-5.6-terra

# Dedicated Alpaca paper account. The runner rejects any non-paper base URL.
ALPACA_API_KEY=replace_with_your_paper_key
ALPACA_SECRET_KEY=replace_with_your_paper_secret
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_MARKET_DATA_URL=https://data.alpaca.markets
ALPACA_COMPETITION_ACCOUNT_ID=replace_with_fresh_paper_account_id
AGENT_MODE=shadow
# Set to 0.20 only if the 180-day coverage gate fails; never exceed 0.20 in fallback mode.
AGENT_ATTENTION_WEIGHT=1.0

# Supabase audit storage. The public API uses the anon key; only the runner receives
# the service role key.
SUPABASE_URL=https://replace-with-project.supabase.co
SUPABASE_ANON_KEY=replace_with_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key

# Fixed competition controls.
AGENT_MAX_POSITION_RISK_PCT=0.01
AGENT_MAX_TOTAL_RISK_PCT=0.03
AGENT_DAILY_LOSS_LIMIT_PCT=0.015
AGENT_FREEZE_AT=2026-09-04T05:00:00+09:00
