# OpenDART: https://opendart.fss.or.kr/
OPENDART_API_KEY=replace_with_your_key

# NAVER API HUB Search Trend (not the legacy Developers endpoint).
NAVER_API_HUB_CLIENT_ID=replace_with_your_client_id
NAVER_API_HUB_CLIENT_SECRET=replace_with_your_client_secret

# Public Data Portal: FSC stock-price and market-index services.
DATA_GO_KR_API_KEY=replace_with_your_public_data_portal_key

# Local, manually downloaded KRX files. Files stay outside Git by default.
KRX_PRICE_CSV=data/raw/krx_prices.csv
KRX_INVESTOR_FLOW_CSV=data/raw/krx_investor_flows.csv

# Community observations obtained by an allowed method.
COMMUNITY_OBSERVATIONS_CSV=data/raw/community_observations.csv

# Generated, Git-ignored mini event-study runs.
STUDY_OUTPUT_ROOT=data/processed/mini_event_study
